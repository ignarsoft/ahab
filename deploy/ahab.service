[Unit]
Description=Ahab Oracle A1 capacity hunter
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ahab
Group=ahab
WorkingDirectory=/opt/ahab
Environment=HOME=/var/lib/ahab
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ahab/.venv/bin/ahab run --config /etc/ahab/ahab.toml --env-file /etc/ahab/notifications.env
# Only retry transient startup/read failures. Configuration/quota errors stay stopped.
Restart=on-failure
RestartPreventExitStatus=1 2 130
RestartSec=120
StateDirectory=ahab
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ahab
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
